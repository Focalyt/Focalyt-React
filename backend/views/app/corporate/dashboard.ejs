        <script>
          (function () {
            var form = document.getElementById('corpAppFilters');
            var spacer = document.getElementById('corpAppFilterSpacer');
            function placeFilterBar() {
              if (form && spacer) spacer.style.height = (form.offsetHeight + 12) + 'px';
            }
            placeFilterBar();
            window.addEventListener('resize', placeFilterBar);
            if (!form) return;
            var dateInput = document.getElementById('corpDate');
            var statusInput = document.getElementById('corpStatus');
            document.querySelectorAll('[data-status]').forEach(function (button) {
              button.addEventListener('click', function () {
                var next = button.getAttribute('data-status') || '';
                statusInput.value = statusInput.value === next ? '' : next;
                form.submit();
              });
            });
            var dropdown = document.getElementById('corpRangeDropdown');
            var toggle = document.getElementById('corpRangeToggle');
            form.querySelectorAll('[data-date]').forEach(function (button) {
              button.addEventListener('click', function () {
                var next = button.getAttribute('data-date');
                dateInput.value = dateInput.value === next ? '' : next;
                form.querySelector('[name="from"]').value = '';
                form.querySelector('[name="to"]').value = '';
                form.submit();
              });
            });
            form.querySelectorAll('select').forEach(function (select) {
              select.addEventListener('change', function () { form.submit(); });
            });
            if (toggle) {
              toggle.addEventListener('click', function () {
                var open = dropdown.hasAttribute('hidden');
                dropdown.hidden = !open;
                toggle.setAttribute('aria-expanded', String(open));
              });
            }
            document.addEventListener('click', function (event) {
              if (!event.target.closest('.corp-app-filter__range')) dropdown.hidden = true;
            });
          })();
          function openMap(lat, long) {
            window.open('https://maps.google.com/?q=' + lat + ',' + long, '_blank', 'noopener');
          }
          function maskUnmask(id) {
            axios({
              method: 'get',
              url: '<%= process.env.MIPIE_BACKEND_URL %>/company/get-candidate-details',
              params: { userId: id },
              headers: { 'x-auth': localStorage.getItem('token') }
            }).then(function () {
              window.location.reload();
            }).catch(function (error) {
              if (error.response && error.response.status === 400) {
                alert('Not enough credits to view this contact.');
              }
            });
          }
        </script>
        <div class="recruiter-quickgrid">
          <a class="recruiter-quickcard" href="<%= process.env.MIPIE_BACKEND_URL %>/company/list-candidates"><i class="feather icon-search" aria-hidden="true"></i><h3>Search candidates</h3><p>Find promising candidates for your next opening.</p></a>
          <a class="recruiter-quickcard" href="<%= process.env.MIPIE_BACKEND_URL %>/company/candidate/shortlisted"><i class="feather icon-award" aria-hidden="true"></i><h3>Your shortlist</h3><p>Review saved profiles and take the next hiring step.</p></a>
          <a class="recruiter-quickcard" href="<%= process.env.MIPIE_BACKEND_URL %>/company/notifications"><i class="feather icon-bell" aria-hidden="true"></i><h3>Notifications</h3><p>Stay up to date with activity in your workspace.</p></a>
        </div>
