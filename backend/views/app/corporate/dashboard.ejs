            <select name="experience" aria-label="Minimum experience"><option value="">All experience</option><option value="0">Fresher</option><option value="1">1+ years</option><option value="3">3+ years</option><option value="5">5+ years</option></select>
            <button class="btn btn-primary" type="submit">Search candidates</button>
          </form>
          <div class="recruiter-quicksearch"><span class="recruiter-muted">Quick searches:</span><a href="<%= process.env.MIPIE_BACKEND_URL %>/company/list-candidates?experience=0">Freshers</a><span class="recruiter-muted">&middot;</span><a href="<%= process.env.MIPIE_BACKEND_URL %>/company/list-candidates?experience=3">Experienced talent</a><span class="recruiter-muted">&middot;</span><a href="<%= process.env.MIPIE_BACKEND_URL %>/company/nearbyCandidates">Candidates near me</a></div>
        </section> -->
        <!-- <section class="recruiter-stats" aria-label="Hiring overview">
          <% [
            ['Active jobs', vacancyCount || 0, 'Manage job postings', '/list/jobs'],
            ['Job responses', applicationCount || 0, 'Review applications', '/interested-candidates'],
            ['Shortlisted', shortlistedCandidates || 0, 'Move hiring forward', '/candidate/shortlisted'],
            ['Available credits', company?.creditLeft || 0, 'View your profile', '/myProfile']
          ].forEach(function(stat) { %>
            <div class="card recruiter-stat"><span class="recruiter-muted"><%= stat[0] %></span><strong><%= stat[1] %></strong><a href="<%= process.env.MIPIE_BACKEND_URL %>/company<%= stat[3] %>"><%= stat[2] %> &rarr;</a></div>
          <% }); %>
