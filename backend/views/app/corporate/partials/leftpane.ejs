<aside class="recruiter-sidebar" id="recruiter-sidebar" aria-label="Company workspace">
  <a class="recruiter-brand" href="<%= process.env.MIPIE_BACKEND_URL %>/company/dashboard">
    <img src="<%= process.env.MIPIE_BACKEND_URL %>/images/logo/logo.png" alt="Focalyt">
    <small>RECRUITER</small>
  </a>
  <div class="recruiter-nav-label">TALENT ACQUISITION</div>
  <nav aria-label="Company navigation">
    <% const recruiterLinks = [
      ['dashboard', '/dashboard', 'airplay', 'Dashboard'],
      ['list-candidates', '/list-candidates', 'search', 'Search Candidates'],
      ['jobs', '/list/jobs', 'file-text', 'Jobs & Responses'],
      ['interested-candidates', '/interested-candidates', 'heart', 'Interested Candidates'],
      ['nearbyCandidates', '/nearbyCandidates', 'map-pin', 'Candidates Near Me'],
      ['shortlisted-candidates', '/candidate/shortlisted', 'award', 'Shortlisted Candidates'],
      ['ongoing-candidates', '/onGoingHiring', 'briefcase', 'On Going Hiring'],
      ['status', '/status', 'flag', 'Status'],
      ['milestone', '/milestone', 'check-circle', 'Milestones'],
      ['Notifications', '/notifications', 'bell', 'Notifications'],
      ['myProfile', '/myProfile', 'user', 'Your Profile']
    ]; %>
    <% recruiterLinks.forEach(function(link) {
      const active = link[0] === 'jobs' ? ['jobList', 'view-jd', 'addjobs', 'edit-jd'].includes(menu) : link[0] === menu;
    %>
      <a href="<%= process.env.MIPIE_BACKEND_URL %>/company<%= link[1] %>" class="<%= active ? 'active' : '' %>" <% if(active) { %>aria-current="page"<% } %>>
        <i class="feather icon-<%= link[2] %>" aria-hidden="true"></i><span><%= link[3] %></span>
      </a>
    <% }); %>
  </nav>
  <div class="recruiter-sidefoot"><strong>Your hiring workspace</strong><br>Find talent, review applications and move your hiring forward.</div>
</aside>
