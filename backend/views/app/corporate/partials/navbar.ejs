<header class="recruiter-top">
  <div class="recruiter-top-bar">
  <button class="recruiter-icon-button recruiter-menu-toggle" type="button" aria-label="Open navigation" aria-controls="recruiter-sidebar" aria-expanded="false"><i class="feather icon-menu" aria-hidden="true"></i></button>
  <nav class="recruiter-topnav" aria-label="Quick navigation">
    <a href="<%= process.env.MIPIE_BACKEND_URL %>/company/list-candidates">Search talent</a>
    <a href="<%= process.env.MIPIE_BACKEND_URL %>/company/list/jobs">Jobs &amp; responses</a>
    <a href="<%= process.env.MIPIE_BACKEND_URL %>/company/onGoingHiring">Ongoing hiring</a>
  </nav>
  <% const recruiterPageNames = { dashboard: 'Dashboard', 'list-candidates': 'Search Candidates', jobList: 'Jobs & Responses', 'view-jd': 'Job Details', addjobs: 'Post a job', 'edit-jd': 'Edit job', 'interested-candidates': 'Interested Candidates', nearbyCandidates: 'Candidates Near Me', 'shortlisted-candidates': 'Shortlisted Candidates', 'ongoing-candidates': 'On Going Hiring', status: 'Status', milestone: 'Milestones', Notifications: 'Notifications', myProfile: 'Your Profile' }; %>
  <span class="recruiter-crumb"><%= recruiterPageNames[menu] || 'Company workspace' %></span>
  <div class="recruiter-top-actions">
    <a class="btn btn-primary" href="<%= process.env.MIPIE_BACKEND_URL %>/company/addjobs">+ Post a job</a>
    <a class="recruiter-icon-button" href="<%= process.env.MIPIE_BACKEND_URL %>/company/notifications" aria-label="Notifications"><i class="feather icon-bell" aria-hidden="true"></i><span class="recruiter-notification-count" id="notification" hidden></span></a>
    <div class="recruiter-account">
      <button class="recruiter-avatar" id="logout-block" type="button" aria-label="Account menu" aria-controls="logout-div" aria-expanded="false"><i class="feather icon-user" aria-hidden="true"></i></button>
      <div class="recruiter-account-menu" id="logout-div" hidden>
        <div class="px-1 py-1 recruiter-muted" id="user-name"></div>
        <a href="<%= process.env.MIPIE_BACKEND_URL %>/company/myProfile">Edit Profile</a>
        <button type="button" id="recruiter-logout">Logout</button>
      </div>
    </div>
  </div>
  </div>
</header>
<script>
(function () {
  const accountButton = document.getElementById('logout-block');
  const accountMenu = document.getElementById('logout-div');
  document.getElementById('user-name').textContent = localStorage.getItem('company') || 'Company account';
  function closeAccount() { accountMenu.hidden = true; accountButton.setAttribute('aria-expanded', 'false'); }
  accountButton.addEventListener('click', function () {
    accountMenu.hidden = !accountMenu.hidden;
    accountButton.setAttribute('aria-expanded', String(!accountMenu.hidden));
  });
  const menuButton = document.querySelector('.recruiter-menu-toggle');
  function closeNavigation() { document.body.classList.remove('recruiter-menu-open'); menuButton.setAttribute('aria-expanded', 'false'); }
  menuButton.addEventListener('click', function () {
    const open = document.body.classList.toggle('recruiter-menu-open');
    menuButton.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', function (event) {
    if (!event.target.closest('.recruiter-account')) closeAccount();
    if (!event.target.closest('.recruiter-sidebar, .recruiter-menu-toggle')) closeNavigation();
  });
  document.addEventListener('keydown', function (event) { if (event.key === 'Escape') { closeAccount(); closeNavigation(); } });
  document.getElementById('recruiter-logout').addEventListener('click', function () {
    $.ajax({ type: 'GET', url: '<%= process.env.MIPIE_BACKEND_URL %>/api/logout', headers: { 'x-auth': localStorage.getItem('token') }, success: function () {
      localStorage.clear(); sessionStorage.clear(); window.location.href = '<%= process.env.MIPIE_BACKEND_URL %>/company/login';
    }, error: function () { window.alert('Unable to log out. Please try again.'); } });
  });
  $.ajax({ type: 'GET', url: '<%= process.env.MIPIE_BACKEND_URL %>/company/notificationCount', headers: { 'x-auth': localStorage.getItem('token') }, success: function (data) {
    const count = Number(data && data.count) || 0;
    const badge = document.getElementById('notification');
    badge.textContent = count > 99 ? '99+' : String(count); badge.hidden = count === 0;
  } });
})();
</script>
