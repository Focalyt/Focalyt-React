<style>
/* Recruiter reference design, scoped to authenticated corporate views. */
body:has(.recruiter-sidebar) {
  --recruiter-ink: #243452;
  --recruiter-muted: #768198;
  --recruiter-blue: #2864db;
  --recruiter-pale: #edf3ff;
  --recruiter-line: #e4e9f2;
  --recruiter-bg: #f5f7fb;
  --recruiter-header-height: 74px;
  margin: 0;
  background: var(--recruiter-bg) !important;
  color: var(--recruiter-ink);
  font: 14px 'Segoe UI', Arial, sans-serif;
}
/* Reserve space only on pages that include the shared workspace header. */
body:has(.recruiter-sidebar):has(.recruiter-top) {
  padding-top: var(--recruiter-header-height) !important;
}
body:has(.recruiter-sidebar) h1,
body:has(.recruiter-sidebar) h2,
body:has(.recruiter-sidebar) h3,
body:has(.recruiter-sidebar) h4,
body:has(.recruiter-sidebar) h5 { color: var(--recruiter-ink); font-family: inherit; }
body:has(.recruiter-sidebar) a { color: var(--recruiter-blue); }
body:has(.recruiter-sidebar) a:focus-visible,
body:has(.recruiter-sidebar) button:focus-visible { outline: 3px solid #a9bfe9; outline-offset: 3px; }
.recruiter-sidebar {
  position: fixed; inset: 0 auto 0 0; z-index: 1040; width: 220px;
  background: white; border-right: 1px solid var(--recruiter-line); overflow-y: auto;
  padding: 25px 17px; display: flex; flex-direction: column;
}
.recruiter-brand { display: block; padding: 0 14px 24px; }
.recruiter-brand img { display: block; width: 150px; max-width: 100%; height: auto; }
.recruiter-brand small { display: block; color: var(--recruiter-muted); font-size: 10px; letter-spacing: 2px; margin-top: 9px; }
.recruiter-nav-label { font-size: 10px; letter-spacing: 1.8px; font-weight: 700; color: var(--recruiter-muted); margin: 15px 14px 12px; }
.recruiter-sidebar nav { display: grid; gap: 3px; }
.recruiter-sidebar nav a { display: flex; align-items: center; gap: 11px; padding: 12px 14px; border-radius: 8px; color: #52617b !important; font-size: 13px; line-height: 1.4; }
.recruiter-sidebar nav a:hover, .recruiter-sidebar nav a.active { background: var(--recruiter-pale); color: var(--recruiter-blue) !important; text-decoration: none; }
.recruiter-sidebar nav a.active { font-weight: 650; }
.recruiter-sidebar nav i { width: 18px; font-size: 17px; }
.recruiter-sidefoot { background: var(--recruiter-bg); border-radius: 9px; padding: 15px; margin: 25px 8px 0; font-size: 12px; color: var(--recruiter-muted); line-height: 1.7; }
.recruiter-sidefoot strong { color: var(--recruiter-ink); }
.recruiter-top {
  position: fixed; top: 0; left: 220px; right: 0; z-index: 1030;
  height: var(--recruiter-header-height); margin: 0; padding: 0 36px;
  background: transparent; border: 0; display: flex; justify-content: center; pointer-events: none;
}
.recruiter-top-bar {
  pointer-events: auto; width: 100%; max-width: 1500px; height: 100%;
  display: flex; align-items: center; justify-content: space-between; gap: 20px;
  background: white; border-bottom: 1px solid var(--recruiter-line);
}
.recruiter-topnav { display: flex; gap: 25px; }
.recruiter-topnav a { font-size: 13px; color: #52617b !important; }
.recruiter-top-actions { display: flex; align-items: center; gap: 14px; }
.recruiter-top .recruiter-crumb { font-size: 12px; color: var(--recruiter-muted); }
.recruiter-icon-button { position: relative; border: 1px solid var(--recruiter-line); border-radius: 8px; background: white; color: var(--recruiter-ink) !important; padding: 9px 12px; }
.recruiter-notification-count { position: absolute; top: -7px; right: -6px; font-size: 10px; border-radius: 20px; background: var(--recruiter-blue); color: white; min-width: 17px; text-align: center; }
.recruiter-account { position: relative; }
.recruiter-avatar { width: 38px; height: 38px; border: 0; border-radius: 50%; background: #e7edfa; color: #4265a5; display: inline-flex; align-items: center; justify-content: center; font-weight: 600; flex-shrink: 0; }
.recruiter-account-menu { position: absolute; top: 48px; right: 0; width: 210px; z-index: 1050; background: white; border: 1px solid var(--recruiter-line); border-radius: 10px; box-shadow: 0 12px 35px #24345215; padding: 8px; }
.recruiter-account-menu[hidden] { display: none; }
.recruiter-account-menu a, .recruiter-account-menu button { display: block; border: 0; width: 100%; text-align: left; background: white; padding: 10px; border-radius: 6px; color: var(--recruiter-ink); }
.recruiter-account-menu a:hover, .recruiter-account-menu button:hover { background: var(--recruiter-pale); }
.recruiter-menu-toggle { display: none; }
body:has(.recruiter-sidebar) .app-content.content {
  margin: 0 0 0 220px !important; padding: 30px 36px 60px !important; min-height: calc(100vh - 145px);
}
body:has(.recruiter-sidebar) .content-wrapper { max-width: 1500px; margin: 0 auto !important; padding: 0 !important; }
body:has(.recruiter-sidebar) .header-navbar-shadow { display: none !important; }
body:has(.recruiter-sidebar) .content-header-title { float: none !important; border: 0 !important; padding: 0 !important; font-size: 30px; font-weight: 650; letter-spacing: -1px; margin: 0 0 12px !important; color: var(--recruiter-ink) !important; }
body:has(.recruiter-sidebar) .breadcrumb-wrapper { padding: 0; }
body:has(.recruiter-sidebar) .breadcrumb { background: none; padding: 0; font-size: 12px; }
body:has(.recruiter-sidebar) .card { background: white; border: 1px solid var(--recruiter-line); border-radius: 13px; box-shadow: 0 2px 6px #25345203; }
body:has(.recruiter-sidebar) .card .card-header { background: transparent; padding: 23px; border-radius: 13px 13px 0 0; }
body:has(.recruiter-sidebar) .card-title { font-size: 18px; font-weight: 650; color: var(--recruiter-ink); }
body:has(.recruiter-sidebar) .card-body { padding: 23px; }
body:has(.recruiter-sidebar) .btn { border-radius: 8px; padding: 10px 15px; font: inherit; box-shadow: none !important; text-transform: none; }
body:has(.recruiter-sidebar) .btn-primary,
body:has(.recruiter-sidebar) .btn-success { border-color: var(--recruiter-blue) !important; background: var(--recruiter-blue) !important; color: white !important; }
body:has(.recruiter-sidebar) .btn-outline-primary { border-color: var(--recruiter-line) !important; color: var(--recruiter-ink) !important; background: white !important; }
body:has(.recruiter-sidebar) .btn-outline-primary:hover { background: var(--recruiter-pale) !important; border-color: var(--recruiter-blue) !important; }
body:has(.recruiter-sidebar) .btn-sm { font-size: 12px; padding: 7px 10px; }
body:has(.recruiter-sidebar) label { color: var(--recruiter-ink); font-size: 12px; font-weight: 600; }
body:has(.recruiter-sidebar) .form-control { border: 1px solid #d7dfea; border-radius: 7px; padding: 10px 11px; min-height: 42px; background: white; color: var(--recruiter-ink); font: inherit; }
body:has(.recruiter-sidebar) .form-control:focus { border-color: #83a8ee; box-shadow: 0 0 0 3px #2864db12; }
body:has(.recruiter-sidebar) .custom-control-input:checked ~ .custom-control-label::before { border-color: var(--recruiter-blue) !important; background-color: var(--recruiter-blue) !important; }
body:has(.recruiter-sidebar) .table thead th { background: #f8fafc !important; color: var(--recruiter-muted) !important; font-size: 10px; letter-spacing: 1px; font-weight: 600; border: 0; white-space: nowrap; }
body:has(.recruiter-sidebar) .table td,
body:has(.recruiter-sidebar) .table th { padding: 17px 13px; border-bottom: 1px solid var(--recruiter-line); }
body:has(.recruiter-sidebar) .table tbody tr:hover { background: #f8faff !important; transform: none; box-shadow: none; }
body:has(.recruiter-sidebar) .badge { font-weight: 600; border-radius: 20px; padding: 5px 9px; font-size: 11px; }
body:has(.recruiter-sidebar) .modal-content { border: 0; border-radius: 15px; overflow: hidden; }
body:has(.recruiter-sidebar) .modal-header { background: var(--recruiter-pale) !important; border-bottom: 1px solid var(--recruiter-line); padding: 24px 28px; }
body:has(.recruiter-sidebar) .modal-header .text-white,
body:has(.recruiter-sidebar) .modal-header .close { color: var(--recruiter-ink) !important; }
body:has(.recruiter-sidebar) .modal-body { padding: 25px 28px; }
body:has(.recruiter-sidebar) .pagination .page-link { border: 1px solid var(--recruiter-line); background: white; color: var(--recruiter-blue); }
body:has(.recruiter-sidebar) .pagination .active .page-link { background: var(--recruiter-blue); color: white; }
body:has(.recruiter-sidebar) footer.footer { margin-left: 220px !important; padding: 20px 36px; background: white; border-top: 1px solid var(--recruiter-line); font-size: 12px; }
.recruiter-head { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 27px; }
.recruiter-eyebrow { color: var(--recruiter-blue); font-size: 11px; font-weight: 700; letter-spacing: 1.5px; }
.recruiter-head h1 { font-size: 30px; font-weight: 650; letter-spacing: -1px; margin: 10px 0; }
.recruiter-head p, .recruiter-muted { color: var(--recruiter-muted); line-height: 1.65; }
.recruiter-head p { margin: 6px 0; }
.recruiter-badge { display: inline-block; background: var(--recruiter-pale); color: var(--recruiter-blue); padding: 5px 9px; border-radius: 20px; font-size: 11px; font-weight: 600; }
.recruiter-badge-gray { background: #edf0f2; color: #6a7b81; }
.recruiter-searchhero { background: linear-gradient(105deg, #eaf2ff, #f1efff); border: 1px solid #dfe8fc; padding: 30px; border-radius: 14px; margin-bottom: 24px; }
.recruiter-searchhero h2 { font-size: 18px; font-weight: 650; margin: 0 0 12px; }
.recruiter-searchbar { display: grid; grid-template-columns: 2fr 1fr auto; gap: 5px; background: white; border: 1px solid var(--recruiter-line); border-radius: 10px; padding: 8px; margin-top: 22px; }
.recruiter-searchbar select { min-width: 0; width: 100%; background: white; border: 0; border-right: 1px solid var(--recruiter-line); color: var(--recruiter-ink); padding: 11px; }
.recruiter-searchbar .btn { padding-left: 25px !important; padding-right: 25px !important; }
.recruiter-quicksearch { display: flex; gap: 12px; flex-wrap: wrap; font-size: 12px; margin-top: 15px; }
.recruiter-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 24px; }
.recruiter-stat { padding: 23px; margin: 0 !important; }
.recruiter-stat strong { display: block; font-size: 32px; font-weight: 600; margin: 12px 0; }
.recruiter-stat a { font-size: 12px; }
.recruiter-two { display: grid; grid-template-columns: 1.65fr 1fr; gap: 20px; }
.recruiter-panel { padding: 23px; margin-bottom: 20px; }
.recruiter-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
.recruiter-bar h2 { margin: 0; font-size: 18px; font-weight: 650; }
.recruiter-bar a { font-size: 12px; }
.recruiter-jobrow { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 22px 0; border-bottom: 1px solid var(--recruiter-line); }
.recruiter-jobrow:last-child { border-bottom: 0; }
.recruiter-jobrow h3 { font-size: 17px; margin: 0 0 8px; }
.recruiter-jobrow p { color: var(--recruiter-muted); font-size: 12px; margin: 5px 0 10px; }
.recruiter-job-list { padding: 0 23px; }
.recruiter-job-list .recruiter-jobrow { flex-wrap: wrap; }
.recruiter-job-summary { flex: 1; min-width: 220px; }
.recruiter-job-actions { display: flex; align-items: center; justify-content: flex-end; gap: 18px; flex-wrap: wrap; }
.recruiter-job-count { display: grid; text-align: center; font-size: 12px; }
.recruiter-job-count strong { font-size: 23px; color: var(--recruiter-blue); }
.recruiter-job-buttons { display: flex; flex-wrap: wrap; gap: 8px; }
.recruiter-hiring-row { display: flex; gap: 14px; padding: 17px 0; border-bottom: 1px solid var(--recruiter-line); }
.recruiter-hiring-row:last-child { border-bottom: 0; }
.recruiter-hiring-row h3 { font-size: 14px; margin: 0 0 8px; }
.recruiter-quickgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-top: 24px; }
.recruiter-quickcard { display: block; padding: 22px; background: white; border: 1px solid var(--recruiter-line); border-radius: 12px; color: var(--recruiter-ink) !important; }
.recruiter-quickcard:hover { border-color: #a9bfe9; text-decoration: none; }
.recruiter-quickcard > i { font-size: 25px; color: var(--recruiter-blue); }
.recruiter-quickcard h3 { font-size: 15px; margin: 14px 0 6px; }
.recruiter-quickcard p { font-size: 12px; color: var(--recruiter-muted); margin: 0; line-height: 1.65; }
.recruiter-empty { text-align: center; padding: 35px 15px; color: var(--recruiter-muted); }
.recruiter-empty i { display: block; font-size: 28px; color: #a9bfe9; margin-bottom: 15px; }
body:has(.recruiter-sidebar) .recruiter-candidate-search { border: 0; background: transparent; box-shadow: none; }
body:has(.recruiter-sidebar) .recruiter-candidate-search > .card-header { padding: 0 0 20px; border: 0 !important; }
.recruiter-candidate-search > .content-body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 22px; padding: 0 !important; }
.recruiter-candidate-search > .content-body > .row { margin: 0 !important; min-width: 0; display: block; }
.recruiter-candidate-search > .content-body > .row > div { padding: 0 !important; }
.recruiter-candidate-search > .content-body > .row:first-child { align-self: start; background: white; border: 1px solid var(--recruiter-line); border-radius: 13px; padding: 20px; }
.recruiter-candidate-search form > .row { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 18px; margin: 0; }
.recruiter-candidate-search form > .row > div { max-width: 100%; min-width: 0; padding: 0; margin: 0 !important; }
.recruiter-candidate-search form .recruiter-search-actions { grid-column: 1/-1; display: flex; justify-content: flex-end; flex-wrap: wrap; align-items: center; gap: 10px; border-top: 1px solid var(--recruiter-line); padding-top: 16px; }
.recruiter-candidate-search form .btn { width: auto; margin: 0 !important; padding: 10px 18px !important; }
.recruiter-filter-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.recruiter-filter-toolbar > strong { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; }
.recruiter-filter-toggle { display: inline-flex; align-items: center; gap: 8px; background: var(--recruiter-pale); color: var(--recruiter-blue); border: 1px solid var(--recruiter-line); border-radius: 7px; padding: 8px 11px; font-size: 12px; cursor: pointer; }
.recruiter-filter-toggle i { transition: transform 280ms ease; }
.recruiter-filter-toggle[aria-expanded="false"] i { transform: rotate(180deg); }
.recruiter-filter-collapse { display: grid; grid-template-rows: 1fr; padding-top: 18px; opacity: 1; transition: grid-template-rows 280ms ease, padding-top 280ms ease, opacity 200ms ease; }
.recruiter-filter-inner { min-height: 0; overflow: hidden; visibility: visible; transition: visibility 0s; }
.recruiter-filter-collapse.is-collapsed { grid-template-rows: 0fr; padding-top: 0; opacity: 0; }
.recruiter-filter-collapse.is-collapsed .recruiter-filter-inner { visibility: hidden; transition: visibility 0s 280ms; }
@media (prefers-reduced-motion: reduce) {
  .recruiter-filter-collapse,.recruiter-filter-inner,.recruiter-filter-toggle i,
  .recruiter-filter-collapse.is-collapsed .recruiter-filter-inner { transition: none; }
}
body:has(.recruiter-sidebar) .recruiter-candidate-search .card.mb-0 { background: transparent; border: 0; box-shadow: none; }
@media (max-width: 1199px) {
