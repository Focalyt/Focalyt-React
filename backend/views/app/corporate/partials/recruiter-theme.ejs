  .recruiter-menu-toggle { display: inline-flex; }
  .recruiter-top .recruiter-crumb { display: none; }
  .recruiter-top-actions { gap: 10px; margin-left: auto; }
  .recruiter-top-actions .btn { font-size: 12px !important; padding: 9px 12px !important; }
  body:has(.recruiter-sidebar) .app-content.content { margin-left: 0 !important; padding: 20px 14px 40px !important; }
  body:has(.recruiter-sidebar) footer.footer { margin-left: 0 !important; padding: 20px 14px; }
  .recruiter-head { align-items: flex-start; flex-direction: column; }
  .recruiter-head h1 { font-size: 27px; }
  .recruiter-searchhero { padding: 22px; }
  .recruiter-searchbar, .recruiter-quickgrid, .recruiter-candidate-search > .content-body { grid-template-columns: 1fr; }
  .recruiter-searchbar select { border-right: 0; border-bottom: 1px solid var(--recruiter-line); }
  .recruiter-candidate-search > .content-body > .row:first-child { margin-bottom: 0 !important; }
  .recruiter-candidate-search form > .row { grid-template-columns: 1fr; }
  .recruiter-candidate-search form .recruiter-search-actions { justify-content: flex-start; }
