<% include ./partials/header %>


  <body class="vertical-layout vertical-menu-modern 2-columns  navbar-floating footer-static  " data-open="click"
    data-menu="vertical-menu-modern" data-col="2-columns">
    <% include ./partials/navbar%>
      <% include ./partials/leftpane%>
      <% include ../../partials/flash %>
        <div class="app-content content">
          <div class="content-overlay"></div>
          <div class="header-navbar-shadow"></div>
          <div class="content-wrapper">
            <div class="content-header row d-xl-block d-lg-block d-md-none d-sm-none d-none">
              <div class="content-header-left col-md-9 col-12 mb-2">
                <div class="row breadcrumbs-top">
                  <div class="col-12">
                    <h3 class="content-header-title float-left mb-0">Jobs &amp; responses</h3>
                    <div class="breadcrumb-wrapper col-12">
                      <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="<%= process.env.MIPIE_BACKEND_URL %>/company/dashboard">Home</a>
                        </li>
                        <li class="breadcrumb-item active">Job Details</li>
                      </ol>
                    </div>
                  </div>
                </div>
              </div>
            </div>

          </div>
          <div class="content-body">
            <section class="list-view">
              <div class="row">
                <div class="col-12 px-3">
                  <div class="card mt-1 mb-5">
                    <div class="card-header border border-top-0 border-left-0 border-right-0 pb-1 px-0">
                      <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-6">
                        <h4 class="card-title">Your job postings</h4>
                      </div>
                      <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-6 text-right">
                        <% if(canAdd && isExist) {%>
                          <a href="<%= process.env.MIPIE_BACKEND_URL %>/company/addjobs" class="btn btn-primary">+ Post a job</a>
                          <%} else if(!canAdd&&isExist){%>
                            <a href="javascript:;" class="btn btn-primary" data-toggle="modal" data-target="#popup" data-dismiss="modal">+ Post a job</a>
                            <%}%>
                      </div>
                    </div>
                    <div class="card-content">
                      <div class="table-responsive">
                        <div class="recruiter-job-list" id="table-body">
                          <% if(jd?.length) { jd.forEach(function(job, index) {
                            const expired = moment(job.validity).utcOffset('+05:30') < moment().startOf('day');
                            const shortlistedCount = shortlistedCandCount.find(function(item) { return String(item._id?.job) === String(job._id); })?.count || 0;
                          %>
                            <article class="recruiter-jobrow">
                              <div class="recruiter-job-summary">
                                <h3><%= job.title || 'Job requirement' %></h3>
                                <p><%= job.displayCompanyName || company?.name || 'Company' %> &middot; <%= job.experience ? job.experience + ' years experience' : 'Fresher' %> &middot; <%= job._qualification?.name || 'Qualification not specified' %></p>
                                <span class="recruiter-badge <%= expired || !job.status ? 'recruiter-badge-gray' : '' %>"><%= expired ? 'Expired' : job.status ? 'Active' : 'Closed' %></span>
                                <span class="recruiter-muted" style="font-size:12px;margin-left:8px">Posted <%= moment(job.createdAt).format('DD MMM YYYY') %></span>
                              </div>
                              <div class="recruiter-job-actions">
                                <div class="recruiter-job-count"><strong><%= shortlistedCount %></strong><span class="recruiter-muted">shortlisted</span></div>
                                <div class="recruiter-job-buttons">
                                  <% if(!expired) { %>
                                    <a class="btn btn-outline-primary btn-sm" href="<%= process.env.MIPIE_BACKEND_URL %>/company/editJobs/<%= job._id %>">Edit</a>
                                    <% if(canAdd) { %><a class="btn btn-outline-primary btn-sm" href="<%= process.env.MIPIE_BACKEND_URL %>/company/addjobs/<%= job._id %>">Copy</a><% } else { %><button class="btn btn-outline-primary btn-sm" type="button" data-toggle="modal" data-target="#popup">Copy</button><% } %>
                                    <a class="btn btn-primary btn-sm" href="<%= process.env.MIPIE_BACKEND_URL %>/company/jobs/<%= job._id %>">View job &rarr;</a>
                                  <% } %>
                                </div>
                                <div class="custom-control custom-switch custom-control-inline mr-0">
                                  <input type="checkbox" class="custom-control-input" id="customSwitch<%= index %>" data-job-id="<%= job._id %>" data-job-status="<%= job.status %>" onclick="myOnOffFunc(this.dataset.jobId,this.dataset.jobStatus)" <%= job.status ? 'checked' : '' %> <%= expired ? 'disabled' : '' %>>
                                  <label class="custom-control-label" for="customSwitch<%= index %>">Active</label>
                                </div>
                              </div>
                            </article>
                          <% }); } else { %>
                            <div class="recruiter-empty"><i class="feather icon-file-text" aria-hidden="true"></i><h3>No job postings yet</h3><p>Your job requirements will appear here.</p></div>
                          <% } %>
                        </div>
                        <% if (totalPages> 1) { %>
                          <ul class="pagination justify-content-end ml-2 mb-2">
                            <% let first=1 %>
                              <% let last=totalPages> 4 ? 4 :
                                totalPages %> <% if (totalPages> 4 && page >= 2) { %>
                                  <% first=page - 1 %>
                                    <% last=page + 1 %>
                                      <% if (last> totalPages) last = totalPages
                                        %> <% } %>
                                          <% if (first> 1) { %>
                                            <li class="page-item">
                                              <a class="pageAnchor page-link" href="jobs?page=<%= 1 %>">First</a>
                                            </li>
                                            <% } %>
                                              <% for (let i=first; i <=last; i +=1) { %>
                                                <% if (i===page) { %>
                                                  <li class="active page-item">
                                                    <a href="javascript:void()" class="page-link">
                                                      <%= i %>
                                                    </a>
                                                  </li>
                                                  <% } else { %>
                                                    <li class="page-item">
                                                      <a class="page-link pageAnchor" href="jobs?page=<%= i %>">
                                                        <%= i %>
                                                      </a>
                                                    </li>
                                                    <% } %>
                                                      <% } %>
                                                        <% if (totalPages>
                                                          last)
                                                          { %>
                                                          <li class="page-item">
                                                            <a class="pageAnchor page-link"
                                                              href="jobs?page=<%= last + 1 %>">...</a>
                                                          </li>
                                                          <li class="page-item">
                                                            <a class="pageAnchor page-link"
                                                              href="jobs?page=<%= totalPages %>">Last</a>
                                                          </li>
                                                          <% } %>
                          </ul>
                          <% } %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </section>
          </div>
        </div>


        <div class="sidenav-overlay"></div>
        <div class="drag-target"></div> 

        <div class="modal fade" id="popup" tabindex="-1" role="dialog"
        aria-labelledby="exampleModalCenterTitle"
        aria-modal="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title text-white text-uppercase" id="exampleModalLongTitle">Complete Profile
              </h5>
              <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">×</span>
              </button>
            </div>
            <div class="modal-body">
              <ul class="list-unstyled">
                <li class="mb-1">
                  <span class="credit font-weight-bold">
                    Current Coins Balance: <%= company?.creditLeft %></span>
                </li>
              </ul>
              <h5 class="pb-1 mb-0">
                Kindly complete your profile before adding Jobs / नौकरियाँ जोड़ने से पहले कृपया अपना प्रोफ़ाइल पूरा करें
              </h5>
            </div>
            <div class="modal-footer">
              <a href="<%= process.env.MIPIE_BACKEND_URL %>/company/myProfile">
                <button type="submit" class="btn btn-primary">Complete Profile</button>
              </a>
              <button type="button" class="btn btn-outline-light" data-dismiss="modal"><i
                class="feather icon-x d-block d-lg-none"></i>
              <span class="d-none d-lg-block">Cancel</span></button>
            </div>
          </div>
        </div>
      </div>

        <script>
          function myOnOffFunc(id, status) {
            let myStatus = true;
            if (status === true || status === "true") {
              myStatus = false;
            }
            let data = { id: id, status: myStatus }
            let headers = { 'x-auth': localStorage.getItem('token') }
            axios.patch(`<%= process.env.MIPIE_BACKEND_URL %>/company/changeStatus`, data, { headers: headers })
              .then((res) => {
                location.reload()
              }).catch((err) => {
                console.log(err)

              })
          }
        </script>
        <% include ./partials/footer%>
      </body>
      </html>