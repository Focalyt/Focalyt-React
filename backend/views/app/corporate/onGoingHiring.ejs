<% include ./partials/header %>

  <body class="vertical-layout vertical-menu-modern 2-columns  navbar-floating footer-static  " data-open="click"
    data-menu="vertical-menu-modern" data-col="2-columns">
    <% include ./partials/navbar%>
      <% include ./partials/leftpane%>
      <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="header-navbar-shadow"></div>
        <div class="content-wrapper">
          <div class="content-body recruiter-candidate-list">
            <% include ../../partials/flash %>
            <section class="list-view">
              <div class="row">
                <div class="col-12">
                  <div class="card mt-1 mb-5">
                    <div class="card-header border border-top-0 border-left-0 border-right-0">
                      <h1 class="card-title mb-0">Ongoing hiring</h1>
                      <span class="recruiter-muted">Candidates: <%= ongoingCandidates?.length || 0 %></span>
                    </div>
                    <div class="recruiter-candidate-filter-panel">
                      <form method="GET" class="recruiter-candidate-filters">
                        <div class="row">
                          <div class="col-xl-4">
                            <label for="username">Name, mobile or WhatsApp</label>
                            <input type="text" name="name" class="form-control" id="username" value="<%= data?.name %>"
                             maxlength="25">
                          </div>
                          <div class="col-xl-4">
                            <label for="status-control">Hiring status</label>
                            <select class="form-control" id="status-control" name="status">
                              <option value="" <% if (status=='') { %> selected <% }%>>Select Option</option>
                              <option value="interview due" <% if (status=='interview due') { %> selected <% }%>>Interview Due</option>
                              <option value="interviewed" <% if (status=='interviewed') { %> selected <% }%>>Interviewed</option>
                              <option value="on hold" <% if (status=='on hold') { %> selected <% }%>>On Hold</option>
                              <option value="offer letter rollout" <% if (status=='offer letter rollout') { %> selected <% }%>>Offer Letter Rollout</option>
                              <option value="hiring on hold" <% if (status=='hiring on hold') { %> selected <% }%>>Hiring on Hold</option>
                              <option value="hired" <% if (status=='hired') { %> selected <% }%>>Hired</option>
                            </select>
                          </div>
                          <div class="col-xl-2">
                            <button type="submit" class="btn btn-success waves-effect waves-light text-white"
                              id="submit-btn">Search</button>
                          </div>
                        </div>
                      </form>
                    </div>
                    <div class="card-content">
                      <div class="table-responsive mt-1">
                        <div class="company-student-list" id="table-body">
                          <% if(ongoingCandidates?.length) { ongoingCandidates.forEach(function(ongoing) { const student = ongoing.candidate?.[0] || {}; %>
                            <%- include('./partials/student-card', {studentCard: {
                              student: student, contactVisible: true, profileRoute: 'candidate/', profileQuery: '?src=onGoing',
                              recordId: ongoing._id,
                              qualification: qualifications.find(function(q) { return String(q._id) === String(student.highestQualification); })?.name,
                              stage: ongoing.status || 'In progress', contextTitle: 'Ongoing hiring',
                              jobTitle: ongoing.job?.title || 'Hiring in progress'
                            }}) %>
                          <% }); } else { %><div class="recruiter-empty">No matching candidates</div><% } %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </section>
          </div>
        </div>
      </div>
      <div class="sidenav-overlay"></div>
      <div class="drag-target"></div>
      <script>

        </script>

        <% include ./partials/footer%>

          <script src="https://kit.fontawesome.com/ce5729505d.js" crossorigin="anonymous"></script>
        </body>
        </html>
