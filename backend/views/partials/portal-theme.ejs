  gap: 2px;
  border-radius: 6px;
  border-inline-start: 4px solid #0e6b5c;
  padding: 6px 9px;
  background: var(--company-soft);
  color: var(--company-teal);
  font-size: .86rem;
  white-space: nowrap;
}
.company-portal .company-vacancy-date--soon { background: #fff3d6; color: #754400; border-color: #b57009; }
.company-portal .company-vacancy-date--closed { background: #eef1f4; color: #4a5c65; border-color: #788792; }
.company-portal .company-vacancy-list .qualification-action-custom-class { display: table-cell; white-space: nowrap; }
.company-portal .company-vacancy-list .custom-switch { display: inline-flex; vertical-align: middle; margin: 0 8px 0 0; }
.company-portal .company-vacancy-list .custom-switch label {
  width: auto;
  height: auto;
  min-height: 1.571rem;
  padding-inline-start: 3.6rem;
  cursor: pointer;
  font-weight: 600;
}
.company-portal .custom-switch input:checked ~ .custom-control-label::before {
  background-color: var(--company-teal) !important;
  border-color: var(--company-teal) !important;
}
.company-portal .custom-switch input:focus-visible ~ .custom-control-label::before {
  outline: 2px solid var(--company-teal);
  outline-offset: 2px;
}
.company-portal .company-vacancy-icon {
  display: inline-grid;
  place-items: center;
  width: 36px;
  height: 36px;
  margin-inline: 2px;
  vertical-align: middle;
  border: 1px solid var(--company-line);
  border-radius: 8px;
  background: #fff;
  cursor: pointer;
}
.company-portal .company-vacancy-icon:hover { background: var(--company-soft); }
.company-portal .company-vacancy-list .pagination { flex-wrap: wrap; padding: 8px; }
.company-portal .company-vacancy-list .pagination .active .page-link { background: var(--company-teal) !important; color: white !important; }

html body.company-portal .app-content.content:has(.company-vacancy-form) { overflow: clip; }
.company-portal .company-vacancy-form { max-width: 1080px; margin-inline: auto; }
.company-portal .company-vacancy-section { padding: 0 20px 20px; margin: 0 0 18px; min-width: 0; }
.company-portal .company-vacancy-section legend { float: left; padding: 14px 0; margin: 0 0 14px; border-bottom: 1px solid var(--company-line); font-size: 1.12rem; font-weight: 700; }
.company-portal .company-vacancy-fields { clear: both; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px 16px; }
.company-portal .company-vacancy-fields :is(label, .company-vacancy-field-label) {
  margin: 0;
  font-size: .95rem;
  font-weight: 600;
