<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&amp;family=Hanken+Grotesk:wght@400;500;600;700&amp;display=swap">
<style>
html body:has(.recruiter-sidebar) {
  --recruiter-ink: #1b2740;
  --recruiter-muted: #6b778c;
  --recruiter-line: #e3e8f0;
  --recruiter-bg: #f2f5fa;
  --recruiter-pale: #e8f0fe;
  --recruiter-blue: #2864db;
  --recruiter-blue-hover: #1f4fb3;
  --recruiter-focus: #1f4fb3;
  font-family: Figtree, system-ui, sans-serif;
}
html body.company-portal {
  --company-ink: #172b2b;
  --company-muted: #4a5c65;
  --company-teal: #0e6b5c;
  --company-soft: #e3f1ee;
  --company-line: #dde2ea;
  background: #f4f6f8;
  color: var(--company-ink);
  font-family: "Hanken Grotesk", system-ui, sans-serif;
}
html body:is(:has(.recruiter-sidebar), .company-portal) :is(button, input, select, textarea, .btn, .form-control) {
  font-family: inherit;
}
html body:is(:has(.recruiter-sidebar), .company-portal) :is(a, button, input, select, textarea, [tabindex]):focus-visible {
  outline: 2px solid var(--recruiter-focus, var(--company-teal)) !important;
  outline-offset: 2px;
}
html body:is(:has(.recruiter-sidebar), .company-portal) .pace .pace-progress {
  background: var(--recruiter-blue, var(--company-teal));
}

/* Recruiter workspace */
.recruiter-sidebar {
  scrollbar-width: thin;
  scrollbar-color: #c7d0df transparent;
}
html body:has(.recruiter-sidebar) :is(.recruiter-brand small, .recruiter-nav-label) {
  letter-spacing: .02em;
  text-transform: none;
}
html body:has(.recruiter-sidebar) .recruiter-sidefoot { color: #52617b; }
.recruiter-sidebar nav a {
  position: relative;
  transition: background-color 200ms ease, color 200ms ease;
}
.recruiter-sidebar nav a::before {
  content: "";
  position: absolute;
  inset: 8px auto 8px 0;
  width: 3px;
  border-radius: 0 3px 3px 0;
  background: var(--recruiter-blue);
  transform: scaleY(0);
  transition: transform 200ms ease;
}
.recruiter-sidebar nav a.active::before { transform: scaleY(1); }
.recruiter-sidebar nav a i { transition: transform 200ms ease; }
.recruiter-sidebar nav a:hover i { transform: translateX(2px); }
html body:has(.recruiter-sidebar) .recruiter-sidebar nav a:is(:hover, .active) {
  color: var(--recruiter-blue-hover) !important;
}

html body:has(.recruiter-sidebar) .recruiter-account-menu {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 200ms ease, transform 200ms ease, display 200ms allow-discrete;
}
html body:has(.recruiter-sidebar) .recruiter-account-menu[hidden] {
  opacity: 0;
  transform: translateY(-6px);
  pointer-events: none;
}
@starting-style {
  html body:has(.recruiter-sidebar) .recruiter-account-menu:not([hidden]) {
    opacity: 0;
    transform: translateY(-6px);
  }
}

html body:has(.recruiter-sidebar) .corp-app-filter { font-family: inherit; }
html body:has(.recruiter-sidebar) .corp-app-filter__bar {
  border: 1px solid var(--recruiter-line);
  border-radius: 0 0 12px 12px;
  box-shadow: 0 4px 16px #1b27400d;
}
html body:has(.recruiter-sidebar) .corp-perf { border-color: var(--recruiter-line); }
html body:has(.recruiter-sidebar) :is(.corp-app-filter__label, .corp-perf__empty) {
  color: var(--recruiter-muted);
  text-transform: none;
  letter-spacing: normal;
}
html body:has(.recruiter-sidebar) .corp-app-filter__label i { color: var(--recruiter-blue); }
html body:has(.recruiter-sidebar) :is(.corp-app-filter__pill, .corp-perf__chip) {
  background: #fff;
  border-color: var(--recruiter-line);
  color: var(--recruiter-ink);
}
html body:has(.recruiter-sidebar) :is(.corp-app-filter__pill, .corp-perf__chip):hover {
  background: var(--recruiter-blue-hover);
  border-color: var(--recruiter-blue-hover);
  color: #fff;
}
html body:has(.recruiter-sidebar) :is(.corp-app-filter__pill, .corp-perf__chip).is-active {
  background: #c32251;
  border-color: #fa5579;
  color: #fff;
  box-shadow: none;
}
html body:has(.recruiter-sidebar) :is(.corp-app-filter__pill, .corp-perf__chip).is-active:hover {
