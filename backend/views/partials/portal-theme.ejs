}

.recruiter-candidate-filter-panel {
  margin-bottom: 12px;
  padding: 14px 16px;
  border: 1px solid var(--recruiter-line);
  border-radius: 12px;
  background: #fff;
}
.recruiter-candidate-filters > .row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr)) auto;
  align-items: end;
  gap: 10px 14px;
  margin: 0;
}
.recruiter-candidate-filters > .row > div {
  max-width: none;
  min-width: 0;
  padding: 0;
}
html body:has(.recruiter-sidebar) .recruiter-candidate-filters .btn {
  min-height: 36px;
  padding: 7px 15px;
}

html body:has(.recruiter-sidebar) .jobs-responses .recruiter-job-list {
  display: grid;
  gap: 12px;
  padding: 0;
}
html body:has(.recruiter-sidebar) .jobs-responses .recruiter-jobrow {
  align-items: stretch;
  gap: 9px;
  padding: 10px;
  border: 1px solid var(--recruiter-line);
  border-radius: 14px;
  background: var(--recruiter-bg);
  box-shadow: 0 2px 8px #1b27400a;
  transition: border-color 200ms ease, box-shadow 200ms ease;
}
html body:has(.recruiter-sidebar) .jobs-responses .recruiter-jobrow:hover {
  border-color: #a9c4f1;
  box-shadow: 0 6px 18px #1b274012;
}
.jobs-responses :is(.recruiter-job-summary, .recruiter-job-actions) {
  min-width: 0;
  max-width: 100%;
  padding: 12px;
  border: 1px solid var(--recruiter-line);
  border-radius: 11px;
  background: white;
  box-shadow: 0 2px 6px #1b274009;
}
.jobs-responses .recruiter-job-summary { overflow-wrap: anywhere; }
.jobs-responses .recruiter-job-summary .recruiter-badge { color: var(--recruiter-blue-hover); }
.jobs-responses .recruiter-job-summary .recruiter-badge-gray { color: #52617b; }
.jobs-responses .recruiter-job-date { display: inline-block; margin-inline-start: 6px; font-size: 12px; }
.jobs-responses .recruiter-job-count {
  padding: 4px 10px;
  border-radius: 8px;
  background: var(--recruiter-pale);
}
.jobs-responses .recruiter-job-count strong { font-size: 18px; line-height: 1.25; }
.jobs-responses .recruiter-job-count .recruiter-muted { color: #52617b; }
.jobs-responses .recruiter-job-actions { justify-content: flex-start; gap: 10px; }
.jobs-responses .recruiter-job-actions .custom-switch label {
  width: auto;
  height: auto;
  min-height: 1.571rem;
  padding-inline-start: 3.6rem;
}
.jobs-responses .custom-switch input:focus-visible ~ .custom-control-label::before {
  outline: 2px solid var(--recruiter-focus);
  outline-offset: 2px;
}
html body:has(.recruiter-sidebar) :is(.recruiter-search-actions, .jobs-responses) .btn-primary:hover,
html body:has(.recruiter-sidebar) :is(.recruiter-search-actions, .recruiter-candidate-filters) button.btn-success:hover {
  background: var(--recruiter-blue-hover) !important;
  border-color: var(--recruiter-blue-hover) !important;
}

html body:has(.recruiter-sidebar) .company-student-list .company-student-card {
  background: var(--recruiter-bg);
  border: 1px solid var(--recruiter-line);
  border-radius: 14px;
  color: var(--recruiter-ink);
  font-family: inherit;
  box-shadow: 0 2px 8px #1b27400a;
  transition: border-color 200ms ease, box-shadow 200ms ease;
}
html body:has(.recruiter-sidebar) .company-student-list .company-student-card:hover {
  border-color: #a9c4f1;
  box-shadow: 0 6px 18px #1b274012;
}
html body:has(.recruiter-sidebar) .company-student-list .company-student-company-header {
  background: transparent;
  border-color: var(--recruiter-line);
}
html body:has(.recruiter-sidebar) .company-student-list .company-student-company-badge {
  color: var(--recruiter-blue-hover);
  background: var(--recruiter-pale);
}
html body:has(.recruiter-sidebar) .company-student-list .company-student-strip { padding: 10px; gap: 9px; }
html body:has(.recruiter-sidebar) .company-student-list :is(.company-student-panel, .company-student-profile) {
  background: white;
  border: 1px solid var(--recruiter-line);
  border-radius: 11px;
  box-shadow: 0 2px 6px #1b274009;
}
html body:has(.recruiter-sidebar) .company-student-list .company-student-avatar {
  background: linear-gradient(145deg, var(--recruiter-blue), #6338ba);
  color: white;
}
html body:has(.recruiter-sidebar) .company-student-list .company-student-panel h3 {
  color: var(--recruiter-ink);
  font-weight: 700;
  text-transform: none;
}
html body:has(.recruiter-sidebar) .company-student-list .company-student-panel h3 > i {
  display: inline-grid;
  place-items: center;
  flex: 0 0 22px;
  height: 22px;
  border-radius: 6px;
  background: var(--recruiter-pale);
  color: var(--recruiter-blue-hover);
}
html body:has(.recruiter-sidebar) .company-student-list .company-student-strip :is(.company-student-meta, .company-student-kv) > span {
  color: var(--recruiter-muted);
}
html body:has(.recruiter-sidebar) .company-student-list .company-student-strip :is(.company-student-meta strong, .company-student-contact) {
  color: var(--recruiter-ink);
}
html body:has(.recruiter-sidebar) .company-student-list .company-followup-panel .company-followup-stat--done {
  background: #e7f6ee;
  color: #0f7a48;
}
html body:has(.recruiter-sidebar) .company-student-list .company-followup-panel .company-followup-stat--planned {
  background: #e8f0fe;
  color: #1d4ed8;
}
html body:has(.recruiter-sidebar) .company-student-list .company-followup-panel .company-followup-stat--missed {
  background: #fdecec;
  color: #c0362c;
}
html body:has(.recruiter-sidebar) .company-student-list .company-followup-stat span { border-color: currentColor; }
html body:has(.recruiter-sidebar) .company-student-list .company-followup-stat strong { font-weight: 700; }
html body:has(.recruiter-sidebar) .company-student-list .company-followup-panel--empty {
  background: #fff7f7;
  border-color: #f6d3d3 !important;
}
html body:has(.recruiter-sidebar) .company-student-list .company-followup-panel--empty :is(h3 > i, .company-followup-edit) {
  border-color: #f6d3d3;
  background: #fdecec;
  color: #a72b25;
}
html body:has(.recruiter-sidebar) .company-student-list .company-followup-panel--empty .company-followup-link { color: #a72b25; }
html body:has(.recruiter-sidebar) .company-student-list .company-student-card .company-student-chevron {
  background: var(--recruiter-pale);
  border-color: var(--recruiter-line);
  color: var(--recruiter-blue-hover);
}
html body:has(.recruiter-sidebar) .company-student-list .company-student-card .company-student-profile-button {
  padding: 8px 10px;
  border: 1px solid var(--recruiter-blue);
  background: var(--recruiter-blue);
  color: white;
  box-shadow: none;
}
html body:has(.recruiter-sidebar) .company-student-list .company-student-profile-button:hover {
  background: var(--recruiter-blue-hover);
}
html body:has(.recruiter-sidebar) .company-student-list .company-student-card .company-student-unmask {
  padding: 5px 8px;
  border: 1px solid var(--recruiter-blue);
  border-radius: 7px;
  background: #fff;
  color: var(--recruiter-blue-hover);
}
html body:has(.recruiter-sidebar) .company-student-list .company-student-card .company-student-unmask.company-student-profile-button {
  margin-top: 0;
  padding: 8px 10px;
}
html body:has(.recruiter-sidebar) .company-student-list .company-student-card .company-student-unmask:hover {
  background: var(--recruiter-pale);
}

/* Company portal */
.company-portal :is(h1, h2, h3, h4, legend, label) {
  color: var(--company-ink);
  font-family: inherit;
}
html body.company-portal .content .content-wrapper .content-header-title {
  color: var(--company-ink);
  font-weight: 700;
}
.company-portal .header-navbar.navbar-theme { background: var(--company-teal) !important; }
html body.company-portal .main-menu .navigation > li.active > a {
  background: var(--company-teal) !important;
  box-shadow: none;
  color: white;
}
.company-portal :is(.breadcrumb a, footer.footer a) { color: var(--company-teal) !important; }
.company-portal .content-body :is(a:not(.text-danger), .primary) { color: var(--company-teal) !important; }
.company-portal .content-body .btn:is(.btn-primary, .btn-success) {
  background: var(--company-teal) !important;
  border-color: var(--company-teal) !important;
  color: #fff !important;
}
.company-portal .content-body .btn:is(.btn-primary, .btn-success):hover { background: #095649 !important; }
.company-portal .content-body :is(.form-control, .btn) { border-radius: 8px; }
.company-portal .content-body .form-control { color: var(--company-ink); border-color: #a2adb9; min-height: 42px; }
.company-portal .content-body .form-control::placeholder { color: var(--company-muted); }
.company-portal .content-body .form-control:focus { border-color: var(--company-teal); box-shadow: none; }
.company-portal .content-body .mandatory { color: #a72b25; }
.company-portal .company-vacancy-list .card,
.company-portal .company-vacancy-section,
.company-portal .content-body section:has(#form) .bg-authentication {
  background: white;
  border: 1px solid var(--company-line);
  border-radius: 14px;
  box-shadow: 0 3px 12px #172b2b0a;
}
.company-portal .company-vacancy-toolbar { display: flex; align-items: center; padding: 16px 20px; }
.company-portal .company-vacancy-toolbar label { display: inline-flex; gap: 8px; align-items: center; margin: 0; cursor: pointer; text-transform: none; }
.company-portal .company-vacancy-toolbar input { accent-color: var(--company-teal); }
.company-portal .company-vacancy-list .table thead th {
  background: var(--company-soft);
  color: var(--company-teal);
  border-color: var(--company-line);
  text-transform: none;
  letter-spacing: normal;
}
.company-portal .company-vacancy-list .table :is(th, td) { padding: 12px 14px; vertical-align: middle; }
.company-portal .company-vacancy-list .table td { color: var(--company-ink); overflow-wrap: anywhere; }
.company-portal .company-vacancy-name { font-weight: 700; }
.company-portal .company-vacancy-date {
