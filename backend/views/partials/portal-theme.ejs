}
html body:has(.recruiter-sidebar) .corp-app-filter__apply { background: var(--recruiter-blue); }
html body:has(.recruiter-sidebar) .corp-app-filter__apply:hover { background: var(--recruiter-blue-hover); }
html body:has(.recruiter-sidebar) .corp-app-filter__item select:is(:hover, :focus) {
  border-color: var(--recruiter-blue);
  box-shadow: none;
}

html body:has(.recruiter-sidebar) .content-wrapper:has(.recruiter-candidate-search) > section > .row,
html body:has(.recruiter-sidebar) :is(.jobs-responses, .recruiter-candidate-list) .list-view > .row {
  margin-inline: 0;
}
html body:has(.recruiter-sidebar) .content-wrapper:has(.recruiter-candidate-search) > section > .row > .col-12,
html body:has(.recruiter-sidebar) :is(.jobs-responses, .recruiter-candidate-list) .list-view > .row > .col-12 {
  padding-inline: 0;
  min-width: 0;
}
html body:has(.recruiter-sidebar) :is(.jobs-responses, .recruiter-candidate-list) .list-view > .row > .col-12 > .card {
  border: 0;
  background: transparent;
  box-shadow: none;
}
html body:has(.recruiter-sidebar) :is(.recruiter-candidate-search, .jobs-responses .list-view .card, .recruiter-candidate-list .list-view .card) > .card-header {
  gap: 10px;
  margin-bottom: 12px;
  padding: 14px 16px;
  background: #fff;
  border: 1px solid var(--recruiter-line) !important;
  border-radius: 12px;
  box-shadow: 0 4px 16px #1b27400d;
}
html body:has(.recruiter-sidebar) :is(.recruiter-candidate-search, .jobs-responses, .recruiter-candidate-list) .card-header h1 {
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: normal;
}
.recruiter-candidate-search #subscription:empty { display: none; }
html body:has(.recruiter-sidebar) .recruiter-candidate-search > .content-body {
  gap: 14px;
}
html body:has(.recruiter-sidebar) .recruiter-candidate-search > .content-body > .row:first-child {
  padding: 14px 16px;
  margin-bottom: 0 !important;
}
html body:has(.recruiter-sidebar) .recruiter-candidate-search form > .row {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px 14px;
}
html body:has(.recruiter-sidebar) :is(.recruiter-candidate-search form, .recruiter-candidate-filters) label {
  margin-bottom: 4px;
  color: var(--recruiter-muted);
  text-transform: none;
}
html body:has(.recruiter-sidebar) :is(.recruiter-candidate-search form select, .recruiter-candidate-filters :is(input, select)).form-control {
  min-height: 36px;
  height: auto;
  padding: 6px 10px;
  border-color: var(--recruiter-line);
  background-color: #f8faff;
  font-size: 12px;
}
html body:has(.recruiter-sidebar) :is(.recruiter-candidate-search form select, .recruiter-candidate-filters :is(input, select)).form-control:focus {
  border-color: var(--recruiter-blue);
}
html body:has(.recruiter-sidebar) .recruiter-candidate-search form .recruiter-search-actions {
  padding-top: 12px;
}
html body:has(.recruiter-sidebar) .recruiter-candidate-search .recruiter-search-actions a.btn {
  border: 1px solid var(--recruiter-line) !important;
  background: white !important;
  color: var(--recruiter-blue-hover) !important;
}
html body:has(.recruiter-sidebar) .recruiter-candidate-search .recruiter-search-actions a.btn:hover {
  border-color: var(--recruiter-blue-hover) !important;
  background: var(--recruiter-blue-hover) !important;
  color: white !important;
}
html body:has(.recruiter-sidebar) .recruiter-candidate-search .recruiter-bar {
  margin-bottom: 10px;
  padding: 10px 14px;
  border: 1px solid var(--recruiter-line);
  border-radius: 10px;
  background: white;
}
.recruiter-candidate-search .recruiter-bar h2 { font-size: 1rem; }
:is(.recruiter-candidate-search, .recruiter-candidate-list) .company-student-list { padding: 0; min-width: 0; }
html body:has(.recruiter-sidebar) :is(.recruiter-candidate-search, .recruiter-candidate-list) .company-student-strip {
  background: transparent;
  border: 0;
}
html body:has(.recruiter-sidebar) :is(.recruiter-candidate-search, .jobs-responses, .recruiter-candidate-list) .table-responsive {
  overflow: visible;
}
html body:has(.recruiter-sidebar) :is(.recruiter-candidate-search, .jobs-responses, .recruiter-candidate-list) .recruiter-empty {
  border: 1px solid var(--recruiter-line);
  border-radius: 12px;
  background: white;
}
html body:has(.recruiter-sidebar) :is(.recruiter-candidate-search, .jobs-responses, .recruiter-candidate-list) .pagination {
  flex-wrap: wrap;
  margin-top: 12px;
}
html body:has(.recruiter-sidebar) :is(.recruiter-candidate-search, .jobs-responses, .recruiter-candidate-list) .pagination .active .page-link {
