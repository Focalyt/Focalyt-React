<% include ../partials/header %>

<div class="content-body">
  <% include ../partials/flash %>
  <section>
    <div class="row">
      <div class="col-xl-12 col-lg-12">
        <div class="card">
          <div class="card-header">
            <h4 class="card-title mb-0">Landing Page</h4>
            <!-- <p class="mb-0 mt-1">The smallest sequence shows first on the public landing page. The first row is the course visitors see at the top.</p> -->
          </div>
          <div class="table-responsive">
            <table class="table table-hover-animation mb-0 table-hover">
              <thead>
                <tr>
                  <th class="jd-sequence">Sequence</th>
                  <th>Course</th>
                  <th>Sector</th>
                  <th>Type</th>
                  <th>Place</th>
                </tr>
              </thead>
              <tbody>
                <% if (courses && courses.length > 0) { %>
                  <% courses.forEach((course, i) => { %>
                    <tr>
                      <td>
                        <input type="number" value="<%= course.sequence != null ? course.sequence : 50 %>"
                          onblur="updateSequence(event,'<%= course._id %>')" name="sequence" maxlength="4"
                          onkeypress="if(this.value.length==4) return false;"
                          class="form-control w-50" data-id="<%= course._id %>">
                      </td>
                      <td><%= course.name %></td>
                      <td>
                        <% if (course.sectors && course.sectors.length) { %>
                          <%= course.sectors.map(function (sector) { return sector.name; }).join(", ") %>
                        <% } else { %>
                          —
                        <% } %>
                      </td>
                      <td><%= course.courseFeeType || "—" %></td>
                      <td>
                        <% if (i === 0) { %>
                          <span class="badge badge-success">Shows first</span>
                        <% } else { %>
                          <%= i + 1 %>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td class="text-center" colspan="5">No live courses found</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  function updateSequence(e, id) {
    const val = e.target.value;
    axios.patch("<%= process.env.MIPIE_BACKEND_URL %>/admin/courses/coursesequence", { id, val }).then((res) => {
      if (res.data.status === true) {
        window.location.reload();
      }
    }).catch((err) => {
      console.log(err);
    });
  }
</script>

<% include ../partials/footer %>
