<% include ../partials/header %>
  <div class="content-header row">
    <div class="content-header-left col-md-9 col-12 mb-2">
      <div class="row breadcrumbs-top">
        <div class="col-12">
          <h3 class="content-header-title float-left mb-0">Vacancies</h3>
          <div class="breadcrumb-wrapper col-12">
            <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="/company">Home</a>
              </li>
              <li class="breadcrumb-item active">Vacancies
              </li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="content-body">
    <% include ../partials/flash %>
      <section class="list-view company-vacancy-list">
        <div class="row">
          <div class="col-12 rounded equal-height-2 coloumn-2">
            <div class="card">
              <div class="company-vacancy-toolbar">
                <label for="checkbox1">
                  <input type="checkbox" onclick="archived()" <%= isChecked === 'true' ? 'checked' : '' %> id="checkbox1">
                  Show archived
                </label>
              </div>
              <div class="card-content">
                <div class="table-responsive">
                  <% if (vacancies && vacancies.length > 0) { %>
                    <% const today = moment().startOf('day'); %>
                    <table class="table table-hover-animation mb-0 table-hover" role="table" aria-label="Vacancies">
                      <thead role="rowgroup">
                        <tr role="row">
                          <th scope="col" role="columnheader">Name</th>
                          <th scope="col" role="columnheader">Company</th>
                          <th scope="col" role="columnheader">Industry</th>
                          <th scope="col" role="columnheader">Closing date</th>
                          <th scope="col" role="columnheader">Type</th>
                          <th scope="col" role="columnheader">Actions</th>
                        </tr>
                      </thead>
                      <tbody role="rowgroup">
                        <% vacancies.forEach((l, i) => {
                          const closing = l.closingDate ? moment(l.closingDate).startOf('day') : null;
                          const hasClosingDate = closing && closing.isValid();
                          const daysLeft = hasClosingDate ? closing.diff(today, 'days') : null;
                          const dateStatus = !hasClosingDate || daysLeft < 0 ? 'closed' : daysLeft <= 3 ? 'soon' : 'open';
                        %>
                          <tr role="row">
                            <td class="text-capitalize company-vacancy-name" role="cell"><%= l.name %></td>
                            <td class="text-capitalize" data-label="Company" role="cell"><%= l._company.name %></td>
                            <td class="text-capitalize" data-label="Industry" role="cell"><%= l._industry.name %></td>
                            <td class="company-vacancy-deadline" data-label="Closing date" role="cell">
                              <div class="company-vacancy-date company-vacancy-date--<%= dateStatus %>">
                                <% if (hasClosingDate) { %>
                                  <strong><%= daysLeft < 0 ? 'Closed' : daysLeft + (daysLeft === 1 ? ' day left' : ' days left') %></strong>
                                  <time datetime="<%= closing.format('YYYY-MM-DD') %>"><%= closing.format('DD-MM-YYYY') %></time>
                                <% } else { %>
                                  <strong>Date unavailable</strong>
                                <% } %>
                              </div>
                            </td>
                            <td class="text-capitalize" data-label="Type" role="cell"><%= l._vacancyType.name %></td>
                            <td class="qualification-action-custom-class" role="cell">
                              <% if (isChecked === 'true') { %>
                                <button type="button" class="company-vacancy-icon" aria-label="Permanently delete <%= l.name %>" title="Delete permanently"
                                  onclick="deleteArchieve('<%= l._id %>', '<%= l.isDeleted %>', 'vacancy');">
                                  <i class="feather icon-trash-2 fa-lg primary" aria-hidden="true"></i>
                                </button>
                              <% } else { %>
                                <div class="custom-control custom-switch custom-control-inline">
                                  <input type="checkbox" onclick="myOnOffFunc('<%= l._id %>', '<%= l.status %>', 'vacancy');"
                                    class="custom-control-input" id="customSwitch<%= i %>" role="switch" aria-label="Live vacancy: <%= l.name %>" <%= l.status ? 'checked' : '' %>>
                                  <label class="custom-control-label" for="customSwitch<%= i %>"><%= l.status ? 'Live' : 'Paused' %></label>
                                </div>
                                <a class="company-vacancy-icon" href="/panel/company/vacancy/edit/<%= l._id %>" aria-label="Edit <%= l.name %>" title="Edit vacancy">
                                  <i class="feather icon-edit fa-lg primary" aria-hidden="true"></i>
                                </a>
                                <button type="button" class="company-vacancy-icon" aria-label="Delete <%= l.name %>" title="Delete vacancy"
                                  onclick="deleteRecord('<%= l._id %>', '<%= l.status %>', 'vacancy');">
                                  <i class="feather icon-trash-2 fa-lg primary" aria-hidden="true"></i>
                                </button>
                              <% } %>
                            </td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  <% } else { %>
                    <p class="text-center mt-3">No vacancies found</p>
                  <% } %>

                        <% if (totalPages> 1) { %>
                          <ul class="pagination justify-content-end ml-2 mb-2">
                            <% let first=1 %>
                              <% let last=totalPages> 4 ? 4 : totalPages %>
                                <% if (totalPages> 4 && page >= 2) { %>
                                  <% first=page - 1 %>
                                    <% last=page + 1 %>
                                      <% if (last> totalPages) last = totalPages %>
                                        <% } %>
                                          <% if (first> 1) { %>
                                            <li class="page-item"><a class="pageAnchor page-link"
                                                href="<%= 1 %>">First</a></li>
                                            <% } %>
                                              <% for (let i=first; i <=last; i +=1) { %>
                                                <% if (i===page) { %>
                                                  <li class="active page-item"><a href="javascript:void()"
                                                      class="page-link">
                                                      <%= i %>
                                                    </a></li>
                                                  <% } else { %>
                                                    <li class="page-item"><a class="page-link pageAnchor"
                                                        href="<%= i %>">
                                                        <%= i %>
                                                      </a></li>
                                                    <% } %>
                                                      <% } %>
                                                        <% if (totalPages> last) { %>
                                                          <li class="page-item"><a class="pageAnchor page-link"
                                                              href="<%= last + 1 %>">...</a></li>
                                                          <li class="page-item"><a class="pageAnchor page-link"
                                                              href="<%= totalPages %>">Last</a></li>
                                                          <% } %>
                          </ul>
                          <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <% include ../partials/footer %>
        <script>
          function myOnOffFunc(id, status, model) { // eslint-disable-line
            let myStatus = true;
            if (status === true || status === 'true') {
              myStatus = false;
            }
            $.ajax({
              type: 'POST',
              url: '/admin/changestatus',
              data: {
                id,
                status: myStatus,
                model,
              },
              success: () => location.reload(),
            });
          }


          function deleteRecord(id, status, model) { // eslint-disable-line
            let myStatus = true;
            if (status === true || status === 'true') {
              myStatus = false;
            }
            var x = confirm("Are you sure you want to delete?");
            if (x) {
              $.ajax({
                type: 'POST',
                url: '/admin/deleteRecord',
                data: {
                  id,
                  status: myStatus,
                  model,
                },
                success: () => window.location.href = "/panel/company/vacancy"
              });
            }
          }
        </script>
        <script>
          !function () { "use strict"; Array.isArray || (Array.isArray = function (r) { return "[object Array]" === Object.prototype.toString.call(r) }); var r = { get: function () { var r = window.location.search, t = {}; return "" === r ? t : (r = r.slice(1), r = r.split("&"), r.map(function (r) { var i, o; r = r.split("="), i = r[0], o = r[1], t[i] ? (Array.isArray(t[i]) || (t[i] = [t[i]]), t[i].push(o)) : t[i] = o }), t) } }; if (window) { if (window.qs) throw new Error("Error bootstrapping qs: window.qs already set."); window.qs = r } }();
        </script>
        <script>
          document.addEventListener('DOMContentLoaded', () => {
            const pageAnchors = document.querySelectorAll('a.pageAnchor');
            const { origin, pathname, search } = window.location;
            const obj = window.qs.get(search);
            const keyArr = Object.keys(obj).filter(x => !!obj[x]);
            let url = `${origin}${pathname}?`;
            keyArr.forEach((x) => {
              if (x !== 'page') {
                url += `${x}=${obj[x]}&`;
              }
            });
            pageAnchors.forEach((el) => {
              const n = el.getAttribute('href');
              el.setAttribute('href', `${url}page=${n}`);
            });
          });
          // show deleted data
          function archived() {
            var checkbox = document.getElementById('checkbox1');
            if (checkbox.checked) {
              var isDeleted = true;
              // alert("isDeleted = " + isDeleted)
              $.ajax({
                type: "GET",
                url: "/company/vacancy?isDeleted=true",
                success: () => window.location.href = "/panel/company/vacancy?isDeleted=true"
              });
            } else {
              var isDeleted = false;
              // alert("isDeleted = " + isDeleted);
              $.ajax({
                type: "GET",
                url: "/company/vacancy?isDeleted=false",
                success: () => window.location.href = "/panel/company/vacancy?isDeleted=false"
              });
            }
          }
          // delete archieve data permanently
          function deleteArchieve(id, isDeleted, model) {
            // alert(isDeleted)
            let myStatus = true;
            if (isDeleted === true || isDeleted === "true") {
              myStatus = true;
            }

            var x = confirm("Are you sure you want to delete?");
            if (x) {
              $.ajax({
                type: "POST",
                url: "/admin/deleteArchieve",
                data: {
                  id,
                  isDeleted: myStatus,
                  model,
                },
                success: () => window.location.href = "/panel/company/vacancy?isDeleted=true"
              });
            }
          }
        </script>